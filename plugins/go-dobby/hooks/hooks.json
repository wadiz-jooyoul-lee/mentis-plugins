{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          },
          {
            "type": "command",
            "if": "Bash(rmdir *)",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-agent.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 스폰 등록"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 훅 등록 점검"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/post-agent.sh"
            ],
            "timeout": 5,
            "statusMessage": "go-dobby 스폰 기록"
          }
        ]
      }
    ]
  }
}
