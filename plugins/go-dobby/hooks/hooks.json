{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          },
          {
            "type": "command",
            "if": "Bash(rmdir *)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh"],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 검사"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"],
            "timeout": 5,
            "statusMessage": "go-dobby 안전 훅 등록 점검"
          }
        ]
      }
    ]
  }
}
